<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (AppCompat requerido por MediaRouter/Cast; la UI es Compose) -->
    <style name="Theme.TruchoRadiosChile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="mediaRouteTheme">@style/TruchoMediaRouter</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.TruchoRadiosChile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TruchoRadiosChile</item>
    </style>

    <!-- Tema para el botón y diálogos de Cast (MediaRouter requiere fondo opaco explícito) -->
    <style name="TruchoMediaRouter" parent="Theme.MediaRouter.Light">
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorPrimary">@color/chile_red</item>
        <item name="colorPrimaryDark">@color/chile_red</item>
        <item name="colorAccent">@color/chile_red</item>
        <item name="mediaRouteButtonTint">@color/cast_button_tint</item>
    </style>
</resources>
